#version 450
// The fog of layer/gi_reproject.hpp (2026-10-17 evening; user: "(b): reproject with the depth, as the GI"): recorded just
// before the second eye's fog composite (the game's shader af60aa16, DeleteMe/20261017/rd-hq-fog/fog6596.hlsl), every
// cell of that eye's two fog volumes (set 0 bindings 10 and 11 of the composite: the light scattered in, and what passes
// through; 3D, the eye's picture / 12 across, 64 deep, R9G9B9E5 words) takes the first eye's volumes at the same point of
// the world. Each eye builds its volumes from its own previous frame, so the two drift apart (the night Mock hq: the
// sky 7 % redder in the left eye after the composite).
// A cell: u, v at its centre, its depth coordinate z = log2(viewDepth * m10.x + m10.y) * m10.z (the composite's c9), the
// view depth from the reversed depth by m3 (c1.zw: viewDepth = m3.x / (1 - m3.y + depth * m3.y)). The point in the world
// is made the lighting's way (this eye's lighting constants c2, c11..c14, c15, as gi_reproject_apply.comp) and the first
// eye's lighting matrix (kept by the GI pass) gives its u, v and depth there; its volumes are read with a linear filter.
// Outside the first eye's volumes the cell keeps its own.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 0, binding = 0) uniform texture3D firstScatter;     // the first eye's volumes, as R9G9B9E5
layout(set = 0, binding = 1) uniform texture3D firstPass;
layout(set = 0, binding = 2) uniform sampler linearClamp;
layout(set = 0, binding = 3, r32ui) uniform uimage3D scatter;     // this eye's, as R32_UINT words
layout(set = 0, binding = 4, r32ui) uniform uimage3D through;
layout(set = 0, binding = 5, std140) uniform Lighting { vec4 c[128]; } lighting;   // this eye's lighting constants
layout(set = 0, binding = 6, std430) readonly buffer Kept { vec4 rows[4]; vec4 scale; uint frame; } kept;   // the first eye's
layout(set = 0, binding = 7, std140) uniform Fog { vec4 c[87]; } fog;   // this eye's composite constants
layout(set = 0, binding = 8, r32f) uniform readonly image2D keptDepth;   // the first eye's depth (the GI pass keeps it)
// 1: a cell behind what the first eye sees, or outside its volumes, keeps this eye's own (until 2026-10-18 15:30). 0 (the
// default): such a cell takes the first eye's fog too - read at the farthest surface the first eye sees over the cell, and
// at the nearest cell inside the first eye's volumes. Headset reports 1 and 6 of 2026-10-18 15:00 (the user: "the fog
// still differs; in the right eye a shadow or light seems drawn over the fog, not hidden by it"): in the right eye only,
// the light through a ruin's roof showed nested rectangles and vertical bands, and the fog before a flame altar a dark
// patch. Guess: with the own cells kept behind the first eye's surfaces, the switch between the two eyes' fog follows the
// lines of equal depth on the walls (nested rectangles down a corridor), visible wherever this eye's own fog has drifted
// from the first eye's. Taking the first eye's everywhere leaves no such seam (layer/gi_reproject.hpp, EVR_FOG_KEEP_OWN=1).
layout(constant_id = 0) const uint keepOwn = 0u;
// A cell behind what the first eye sees (2026-10-18 18:30, headset reports 4 and 6 of 18:27/18:30, the user: "something
// beside the right eye's view blurs to the right - again; I can see the sun through the clouds, is a dynamic fog missing?"):
// read at the first eye's farthest surface over the cell, the sky behind a held sword took the fog up to the sword only, a
// sword-shaped clear patch to the right of the sword in the right eye (all 20 pictures of report 6). Now the first eye's
// fog at the same depth beside it: the nearest cell, up to behindSearch cells to the right, left, up and down (right first:
// the second eye sees past an object's right side), over which the first eye sees beyond the cell. None: as before, at its
// farthest surface. 0: no search (15:40). EVR_FOG_BEHIND_SEARCH (layer/gi_reproject.hpp).
layout(constant_id = 1) const uint behindSearch = 16u;

// The farthest surface the first eye sees over a cell's footprint at uv (n x n samples; reversed depth, the smallest).
float farthestSeen(vec2 uv, vec2 footprint, int n) {
    float seen = 1.0;
    for (int j = 0; j < n; ++j) for (int i = 0; i < n; ++i) {
        vec2 o = (vec2(i, j) + 0.5) / float(n) - 0.5;
        ivec2 q = clamp(ivec2(uv * kept.scale.zw + o * footprint), ivec2(0), ivec2(kept.scale.zw) - 1);
        seen = min(seen, imageLoad(keptDepth, q).x);
    }
    return seen;
}

vec3 unpackE5(uint w) {
    float scale = exp2(float(int(w >> 27u)) - 15.0 - 9.0);
    return vec3(float(w & 511u), float((w >> 9u) & 511u), float((w >> 18u) & 511u)) * scale;
}

uint packE5(vec3 rgb) {
    const float maxValue = 65408.0;   // (2^9 - 1) / 2^9 * 2^(31 - 15)
    rgb = clamp(rgb, vec3(0.0), vec3(maxValue));
    float largest = max(rgb.r, max(rgb.g, rgb.b));
    if (largest <= 0.0) return 0u;
    int e = max(-16, int(floor(log2(largest)))) + 16;   // biased shared exponent (bias 15) before the rounding check
    float scale = exp2(float(e - 15 - 9));
    if (floor(largest / scale + 0.5) >= 512.0) { e += 1; scale *= 2.0; }
    uvec3 m = uvec3(floor(rgb / scale + 0.5));
    m = min(m, uvec3(511u));
    return m.r | (m.g << 9) | (m.b << 18) | (uint(clamp(e, 0, 31)) << 27);
}

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(scatter);
    if (any(greaterThanEqual(p, size))) return;
    vec3 m10 = fog.c[9].xyz;
    vec2 m3 = fog.c[1].zw;
    vec3 uvz = (vec3(p) + 0.5) / vec3(size);
    float viewDepth = (exp2(uvz.z / m10.z) - m10.y) / m10.x;
    if (viewDepth <= 0.0) return;
    float depth = (m3.x / viewDepth - 1.0 + m3.y) / m3.y;   // reversed: near 1, far towards 0
    vec3 v = vec3(uvz.x * 2.0 - 1.0, 1.0 - uvz.y * 2.0, depth);
    vec4 m0 = lighting.c[11], m1 = lighting.c[12], m2 = lighting.c[13], mw = lighting.c[14];
    float w = dot(mw.xyz, v) + mw.w;
    if (w == 0.0) return;
    vec3 world = vec3(dot(m0.xyz, v) + m0.w, dot(m1.xyz, v) + m1.w, dot(m2.xyz, v) + m2.w) / w + lighting.c[15].xyz;
    vec4 clip = vec4(dot(kept.rows[0].xyz, world) + kept.rows[0].w, dot(kept.rows[1].xyz, world) + kept.rows[1].w,
                     dot(kept.rows[2].xyz, world) + kept.rows[2].w, dot(kept.rows[3].xyz, world) + kept.rows[3].w);
    if (clip.w <= 0.0) return;
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = vec2(ndc.x + 1.0, 1.0 - ndc.y) * 0.5;
    if (ndc.z <= 0.0) return;
    // Beside the first eye's view (2026-10-19, the eyes turned toward the middle of their fields, openxr_client.hpp
    // decideCant; headset reports 1 and 2 of 04:26 / 04:29, the user: "a light flickers in the right eye - at its edge,
    // outside the left eye's view"): turned outward, the second eye sees about 12 degrees (some 13 cells) past the first
    // eye's side. Each of those cells took the first eye's nearest edge cell, so that band was the first eye's edge column
    // drawn out sideways and flashed whenever that column passed something bright. There this eye keeps its own fog,
    // taking the first eye's more and more over the last fadeCells cells inside its picture (no seam at its edge). Decided
    // at the cell's own place, before the search below can move it inside.
    const float fadeCells = 3.0;
    vec2 inside = min(uv, 1.0 - uv) * vec2(size.xy) - 0.5;   // cells inside the first eye's picture (negative: outside)
    float take = keepOwn != 0u ? 1.0 : clamp(min(inside.x, inside.y) / fadeCells, 0.0, 1.0);
    if (take <= 0.0) return;   // wholly outside: this eye's own, as the game made it
    // Behind what the first eye sees there (2026-10-17 night; user: "the feet and hands look see-through"; Mock: a green
    // square and a dark band beside the arm in the second eye only, gone without this pass): the game does not keep the
    // fog cells behind the visible surface up to date (guess), so a cell the first eye cannot see keeps this eye's own.
    // 2026-10-18 (headset report 7 of 12:22: the fog at a gate smooth in the left eye, broken into dark specks in the right
    // eye, in front of foliage; the user: "mostly where the fog meets the clear air"): a cell covers about 12 x 12 pixels,
    // and its centre's one depth sample flipped from cell to cell between leaves and the gaps behind them, so this eye's
    // own fog and the first eye's alternated. Now the farthest surface the first eye sees over the cell's footprint (4 x 4
    // samples) decides: kept as its own only where the first eye sees nothing beyond the cell anywhere in it (an arm).
    // 2026-10-19 (the eyes turned toward the middle of their fields; headset reports of 04:26 .. 04:39, the user: "a whitish
    // light in the right eye, mostly on the right of the sword, faintly on its left, always at the right edge"): Mock with the
    // sword held still (test_env/sword-static-1019-*): white puffs on the walls in the right eye only (game-20261019-045112);
    // none without this pass (-045431, EVR_FOG_REPROJECT=0), none with the eyes not turned (-044822), faint seams only with
    // the own fog kept behind and outside (-045732, EVR_FOG_KEEP_OWN=1). The puffs came from the cells the first eye cannot
    // see: the search below took the first eye's fog up to 16 cells away - beside the pillar, the light of the gate - and
    // the turned eyes see more of each other's blind parts. Now no search: the share of the cell's footprint over which the
    // first eye sees beyond the cell (4 x 4 samples of its depth) is how much of the first eye's fog the cell takes; the
    // rest is this eye's own. A cell hidden from the first eye keeps its own, and its edge blends instead of switching.
    // EVR_FOG_BEHIND_SEARCH (behindSearch) is no longer read here.
    vec2 footprint = kept.scale.zw / vec2(size.xy);   // the cell's size in the first eye's depth pixels
    float limit = ndc.z * 1.05 + 1e-7;               // reversed depth: the first eye sees beyond the cell where its depth <= limit
    float beyond = 0.0;
    for (int j = 0; j < 4; ++j) for (int i = 0; i < 4; ++i) {
        vec2 o = (vec2(i, j) + 0.5) / 4.0 - 0.5;
        ivec2 q = clamp(ivec2(uv * kept.scale.zw + o * footprint), ivec2(0), ivec2(kept.scale.zw) - 1);
        if (imageLoad(keptDepth, q).x <= limit) beyond += 1.0;
    }
    beyond /= 16.0;
    if (keepOwn != 0u) { if (beyond < 1.0) return; } else take *= beyond;
    if (take <= 0.0) return;
    float sampleDepth = ndc.z;
    float otherViewDepth = m3.x / (1.0 - m3.y + sampleDepth * m3.y);
    float z = log2(otherViewDepth * m10.x + m10.y) * m10.z;
    // the first eye's volume covers [0, 1]; half a cell inside its edge, else this eye keeps its own
    vec3 halfCell = 0.5 / vec3(size);
    vec3 at = vec3(uv, z);
    if (any(lessThan(at, halfCell)) || any(greaterThan(at, 1.0 - halfCell))) {
        if (keepOwn != 0u) return;
        at = clamp(at, halfCell, 1.0 - halfCell);   // beyond the first eye's depth range (z): its nearest cell
    }
    vec3 firstS = textureLod(sampler3D(firstScatter, linearClamp), at, 0.0).rgb;
    vec3 firstP = textureLod(sampler3D(firstPass, linearClamp), at, 0.0).rgb;
    if (take < 1.0) {
        firstS = mix(unpackE5(imageLoad(scatter, p).x), firstS, take);
        firstP = mix(unpackE5(imageLoad(through, p).x), firstP, take);
    }
    imageStore(scatter, p, uvec4(packE5(firstS)));
    imageStore(through, p, uvec4(packE5(firstP)));
}
