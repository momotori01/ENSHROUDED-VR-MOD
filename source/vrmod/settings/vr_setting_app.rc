PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Enshrouded VR setting"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Enshrouded VR MOD"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "Enshrouded VR setting.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
